# Ambiente seguro desta versão: somente test ou sandbox.
APP_STAGE=test
PAYMENT_MODE=mock

# PostgreSQL. Nunca envie a URL verdadeira ao GitHub.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/obraexpress
PGSSLMODE=disable
PG_POOL_MAX=10

# Servidor e autenticação. Gere valores longos e diferentes no Render.
PORT=3000
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
TRUST_PROXY=1
JSON_LIMIT=4mb

# Endereço público. Enquanto não houver domínio próprio, use a URL do Render.
PUBLIC_URL=https://obraexpress-1.onrender.com
CORS_ORIGINS=https://obraexpress-1.onrender.com

# Identificação exibida nos documentos. Não coloque endereço residencial no GitHub.
EMPRESA_NOME=
EMPRESA_DOCUMENTO=
EMPRESA_ENDERECO=
EMPRESA_EMAIL_SUPORTE=
EMPRESA_EMAIL_PRIVACIDADE=

# Recuperação de senha. Só preencher no Render após verificar um domínio na Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Preparação futura do Asaas. Permanecem vazias nesta etapa.
# Use somente credenciais do Sandbox; nunca envie chaves ao GitHub.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
